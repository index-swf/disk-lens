{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "allow-scan-drive",
    "allow-get-node",
    "allow-list-drives",
    "allow-pick-folder",
    "allow-cancel-scan",
    "allow-export-scan-data"
  ]
}
